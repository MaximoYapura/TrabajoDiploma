<?xml version="1.0" encoding="utf-8"?>
<!--
  Plantilla de App.secrets.config (credenciales SMTP para enviar el comprobante de reserva).
  1. Copiar este archivo como App.secrets.config en la misma carpeta (GUI/Config).
  2. Completar el remitente, el usuario y la contraseña de aplicación de Gmail
     (Cuenta de Google > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
  App.secrets.config está en .gitignore: nunca se sube al repositorio.
  Sin ese archivo, la aplicación funciona y solo informa que el envío de emails no está configurado.
-->
<smtp deliveryMethod="Network" from="El Fogón del Sur &lt;CORREO_REMITENTE@gmail.com&gt;">
  <network host="smtp.gmail.com" port="587" enableSsl="true"
           defaultCredentials="false"
           userName="CORREO_REMITENTE@gmail.com"
           password="SU_CONTRASEÑA_AQUI" />
</smtp>
