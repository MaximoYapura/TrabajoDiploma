<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<connectionStrings>
		<add name="TP_Ing_Soft" connectionString="Data Source=PC_Maximo;Initial Catalog=TP_Ing_Soft;Integrated Security=True" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!--
		  MODO DEMOSTRACIÓN. Con "true", si la hora actual no cae en ningún turno de
		  atención (18:00, 20:00, 22:00; 2 h cada uno), la BLL usa TurnoPrueba_790MY como
		  turno vigente para Abrir Mesa, Walk-in y el plano: la aplicación se puede probar
		  a cualquier hora. Con "false" se aplica el control de turnos estricto (producción).
		  Para probar "Con reserva", registrá la reserva para HOY en el turno TurnoPrueba_790MY.
		-->
		<add key="ModoDemostracion" value="true" />
		<add key="TurnoPrueba_790MY" value="22:00" />
	</appSettings>
  <!--
    ENVÍO DEL COMPROBANTE DE RESERVA POR EMAIL (System.Net.Mail)
    ReservaBLL_790MY.EnviarComprobanteEmail toma de acá el servidor SMTP y el remitente.

    Las credenciales NO están en este archivo: el nodo <smtp> se lee de
    App.secrets.config (GUI/Config, copiado junto al .exe al compilar). Ese archivo
    está en .gitignore; para crearlo, copiar App.secrets.config.template y completar
    el remitente, el usuario y la contraseña de aplicación de Gmail.

    Sin App.secrets.config el sistema funciona con normalidad: la reserva se registra,
    la vista previa se muestra y "Guardar PDF" funciona; el modal solo indica que el
    envío de emails no está configurado.
  -->
  <system.net>
    <mailSettings>
      <smtp configSource="App.secrets.config" />
    </mailSettings>
  </system.net>
  
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="BouncyCastle.Crypto" publicKeyToken="0e99375e54769942" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.9.0.0" newVersion="1.9.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>