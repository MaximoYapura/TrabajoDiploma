<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<connectionStrings>
		<add name="TP_Ing_Soft" connectionString="Data Source=PC_Maximo;Initial Catalog=TP_Ing_Soft;Integrated Security=True" providerName="System.Data.SqlClient" />
	</connectionStrings>
  <!--
    ENVÍO DEL COMPROBANTE DE RESERVA POR EMAIL (System.Net.Mail)
    ReservaBLL_790MY.EnviarComprobanteEmail toma de acá el servidor SMTP y el remitente.
    Mientras esta sección esté comentada, la reserva se registra igual y el comprobante
    se puede guardar en PDF; el modal avisa que el envío de emails no está configurado.

    Para activarlo, descomentá el bloque y completá tus datos. Con Gmail se usa una
    "contraseña de aplicación" (Cuenta de Google > Seguridad > Verificación en 2 pasos >
    Contraseñas de aplicaciones), no la contraseña habitual de la cuenta.

  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="El Fogón del Sur &lt;tu.cuenta@gmail.com&gt;">
        <network host="smtp.gmail.com" port="587" enableSsl="true"
                 defaultCredentials="false"
                 userName="tu.cuenta@gmail.com" password="contraseña-de-aplicacion" />
      </smtp>
    </mailSettings>
  </system.net>
  -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="BouncyCastle.Crypto" publicKeyToken="0e99375e54769942" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.9.0.0" newVersion="1.9.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>