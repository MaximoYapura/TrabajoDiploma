<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<connectionStrings>
		<add name="TP_Ing_Soft" connectionString="Data Source=PC_Maximo;Initial Catalog=TP_Ing_Soft;Integrated Security=True" providerName="System.Data.SqlClient" />
	</connectionStrings>
  <!--
    ENVÍO DEL COMPROBANTE DE RESERVA POR EMAIL (System.Net.Mail)
    ReservaBLL_790MY.EnviarComprobanteEmail toma de acá el servidor SMTP y el remitente.

    Mientras el bloque SMTP de abajo esté comentado el sistema funciona con normalidad:
    la reserva se registra, la vista previa se muestra y "Guardar PDF" funciona; el
    modal solo indica que el envío de emails no está configurado.

    NOTA: completá las credenciales ÚNICAMENTE en tu entorno local y no las subas al
    repositorio. Reemplazá solo los placeholders en mayúsculas:
      - CORREO_REMITENTE@gmail.com               (dos veces: en "from" y en "userName")
      - CONTRASENA_DE_APLICACION_16_CARACTERES
    Con Gmail se usa una "contraseña de aplicación" (Cuenta de Google > Seguridad >
    Verificación en 2 pasos > Contraseñas de aplicaciones), no la contraseña de la cuenta.

    Para activarlo, borrá completas las dos líneas marcadas "INICIO" y "FIN" del bloque.
  -->
 
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network" from="El Fogón del Sur &lt;CORREO_REMITENTE@gmail.com&gt;">
        <network host="smtp.gmail.com" port="587" enableSsl="true"
                 defaultCredentials="false"
                 userName="elfogondelsurr@gmail.com"
                 password="pmms bcpk ukpa tjpf" />
      </smtp>
    </mailSettings>
  </system.net>
  
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="BouncyCastle.Crypto" publicKeyToken="0e99375e54769942" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.9.0.0" newVersion="1.9.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>